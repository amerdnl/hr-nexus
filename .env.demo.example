# Settings for the local public demo (docker-compose.demo.yml).
#
#   cp .env.demo.example .env.demo
#
# .env.demo is ignored by Git and must never be committed. Generate each secret
# fresh, for example with:  openssl rand -base64 36
# Do not reuse the default environment's values.

# The Postgres password for the demo's own database container.
POSTGRES_PASSWORD=change-me

# Signs sign-in tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Protects GET/POST /api/demo/reset. At least 16 characters.
CRON_SECRET=replace-with-a-long-random-secret

# How long a sign-in lasts.
JWT_EXPIRES_IN=8h

# Optional. Sets the password of the HR administrator, manager and employee
# sign-ins so those views can be captured locally. Leave it unset and only the
# read-only demo sign-in can be used, which is what a public demo wants.
# PRESENTATION_PASSWORD=
