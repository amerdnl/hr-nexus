# Settings for running HR Nexus locally (docker-compose.yml).
#
#   cp .env.example .env
#
# .env is ignored by Git and must never be committed. Generate each secret
# fresh, for example with:  openssl rand -hex 32
# The hosted demo's variables are listed in the README under Deployment.

# The Postgres password for the demo's own database container.
POSTGRES_PASSWORD=change-me

# Signs sign-in tokens.
JWT_SECRET=replace-with-a-long-random-secret

# Protects GET/POST /api/demo/reset. At least 16 characters.
CRON_SECRET=replace-with-a-long-random-secret

# How long a sign-in lasts.
JWT_EXPIRES_IN=8h

