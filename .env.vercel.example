# HR Nexus on Vercel: environment reference for the public demo deployment.
#
# This file is a template. It contains no real values and never should: every
# entry below is set in the Vercel dashboard (Project → Settings → Environment
# Variables), or passed on the command line for the one-time database setup.
# Nothing here is read at runtime.
#
# WHICH VARIABLES THE RUNTIME ACTUALLY NEEDS
#
# Only the first group. The setup group is used from your own machine, against
# the hosted database - the deployed server never reads those, so putting them
# in Vercel is unnecessary.

# --------------------------------------------------------------- the runtime
# The hosted Postgres connection string, read by backend/src/config/db.ts. The
# server refuses to start without it. A Neon URL already ends in
# ?sslmode=require, which node-postgres honours; keep that on the end.
# Point it at a database that holds ONLY the demo: the nightly reset empties
# every table, and refuses any database with people outside the demo range.
DATABASE_URL=replace-with-hosted-demo-postgres-url

# Signs sign-in tokens. Generate a fresh one, for example:
#   openssl rand -base64 48
# Do not reuse the local development secret.
JWT_SECRET=replace-with-long-random-secret

# How long a sign-in lasts.
JWT_EXPIRES_IN=7d

# Turns on the public demo: GET /api/demo (the published read-only sign-in for
# the login page) and the nightly reset. Anything but "true" leaves both off.
DEMO_MODE=true

# Protects /api/demo/reset. Vercel Cron sends it as "Authorization: Bearer …"
# when this variable is set, which is how vercel.json's nightly cron gets in.
# At least 16 characters, for example:  openssl rand -hex 32
CRON_SECRET=replace-with-long-random-secret

# Only used to set the CORS origin (backend/src/app.ts). On Vercel the browser
# calls /api on the same origin it loaded the page from, so no CORS applies and
# this can be left unset. Set it only if you serve the frontend elsewhere.
# FRONTEND_URL=https://your-project.vercel.app

# Where profile photographs are written. A serverless host cannot write next to
# its own code, so without this the server starts but refuses photographs.
# The demo account cannot upload one anyway; leave it unset.
# PROFILE_IMAGE_DIR=/tmp/profile-images

# ----------------------------------------------------------- the build input
# Makes the built frontend call /api on its own origin instead of the local
# development fallback.
VITE_API_BASE_URL=/api

# ------------------------------------------ setup, from your own machine
# The same hosted Postgres URL, under the names the scripts read. They are
# separate variables on purpose: each script refuses to fall back to the
# application's own database, so pointing a migration or a reset at the wrong
# place takes a deliberate act rather than a forgotten export.
MIGRATION_DATABASE_URL=replace-with-same-hosted-postgres-url
DEMO_DATABASE_URL=replace-with-same-hosted-postgres-url
